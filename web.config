<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\PkiPortal.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="App_Data" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <!-- SECURITY (2.1.0): HSTS (applicato solo su HTTPS: su HTTP i browser lo ignorano) -->
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
          <!-- SECURITY (2.1.0): CSP stricta: solo risorse same-origin, niente script inline
               (il preloader del tema e i handler sono stati spostati in file esterni),
               style 'unsafe-inline' necessario per gli attributi style="..." della UI. -->
          <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>

