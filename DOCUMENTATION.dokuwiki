        "IsDefault": true,
        "UseSimulator": false,
        "AuthMode": "CredentialManager",
        "CredentialTarget": "subca01.foresta1.lan",
        "Templates": [
          {
            "Name": "WebServer",
            "DisplayName": "Web Server (1 Anno)",
            "RequiresApproval": false,
            "ValidityDays": 365
          }
        ]
      },
      {
        "Id": "ca-foresta2",
        "DisplayName": "Foresta 2 - Sviluppo/DMZ (foresta2.lan)",
        "ForestOrDomain": "foresta2.lan",
        "ConfigString": "subca02.foresta2.lan\\Foresta2-SubCA",
        "IsDefault": false,
        "UseSimulator": false,
        "AuthMode": "CredentialManager",
        "CredentialTarget": "subca02.foresta2.lan",
        "Templates": [
          {
            "Name": "WebServer",
            "DisplayName": "Web Server (1 Anno)",
