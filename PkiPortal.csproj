<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.5.0</Version>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>


    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- SECURITY (2.3.1 - TODO): aggiornare a 8.0.32 appena possibile: 8.0.31 è
         vulnerabile a CVE-2026-70179 (GHSA-vrrp-6v32-2p8g, elevation of privilege
         in Negotiate/LDAP claim resolution). Bloccato in questo ambiente da
         TLS MITM su nuget.org. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="held-requests.json" CopyToPublishDirectory="Never" />
    <Content Update="acme-store.json" CopyToPublishDirectory="Never" />
    <Content Update="store-entropy.bin" CopyToPublishDirectory="Never" />
    <Content Update="store-key.bin" CopyToPublishDirectory="Never" />
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
    <Content Update="logs\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
