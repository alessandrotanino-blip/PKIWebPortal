<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.3.1</Version>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
    <FileVersion>2.3.1.0</FileVersion>


    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="held-requests.json" CopyToPublishDirectory="Never" />
    <Content Update="acme-store.json" CopyToPublishDirectory="Never" />
    <Content Update="store-entropy.bin" CopyToPublishDirectory="Never" />
    <Content Update="store-key.bin" CopyToPublishDirectory="Never" />
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
    <Content Update="logs\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
