{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AcmeConfig": {
    "Enabled": true,
    "BaseUrl": "https://pki.corp.contoso.com",
    "DefaultCaId": "Contoso Sub CA",
    "DefaultTemplateName": "WebServer5y",
    "AllowedTemplates": [
      "WebServer5y"
    ],
    "AllowedDomains": [
      "corp.contoso.com"
    ],
    "ValidationMode": "Http01",
    "HttpPort": 80,
    "AllowPrivateIpValidation": false,
    "ChallengeTimeoutSeconds": 15,
    "RequireTermsOfServiceAgreed": true,
    "TermsOfServiceUrl": "/acme/terms"
  },
  "AdminConfig": {
    "AllowedGroups": [
      "BUILTIN\\Administrators",
      "CONTOSO\\Domain Admins"
    ],
    "AllowedUsers": [
      "CONTOSO\\user-adm"
    ]
  },
  "PortalConfig": {
    "PortalMode": "Hub",
    "PortalTitle": "Enterprise PKI Web Enrollment Portal",
    "DefaultCaId": "Contoso-CA",
    "cas": [
      {
        "Id": "Contoso Sub CA",
        "DisplayName": "Contoso Sub CA",
        "ForestOrDomain": "corp.contoso.com",
        "ConfigString": "pki.corp.contoso.com\\Contoso Sub CA",
        "IsDefault": true,
        "UseSimulator": false,
        "Description": "Issuing Subordinate CA",
        "AuthMode": "LocalIdentity",
        "CredentialTarget": "pki.corp.contoso.com",
        "Templates": [
          {
            "Name": "WebServer5y",
            "DisplayName": "Web Server SSL/TLS",
            "Description": "Certificato server per siti web, IIS, appliance e reverse proxy",
            "RequiresApproval": true,
            "StorePrivateKeyForRetrieval": true,
            "ValidityDays": 365,
            "AllowedKeyTypes": [
              "RSA-2048",
              "RSA-4096",
              "ECDSA-P256"
            ],
            "KeyUsages": [
              "DigitalSignature",
              "KeyEncipherment"
            ],
            "ExtendedKeyUsages": [
              "ServerAuthentication"
            ]
          },
          {
            "Name": "ClientAuth2y",
            "DisplayName": "Client Authentication",
            "Description": "Certificato client per autenticazione utente e postazioni",
            "RequiresApproval": false,
            "StorePrivateKeyForRetrieval": true,
            "ValidityDays": 365,
            "AllowedKeyTypes": [
              "RSA-2048",
              "RSA-4096",
              "ECDSA-P256"
            ],
            "KeyUsages": [
              "DigitalSignature",
              "KeyEncipherment"
            ],
            "ExtendedKeyUsages": [
              "ClientAuthentication"
            ]
          }
        ]
      }
    ]
  }
}
